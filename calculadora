def calcular_impostos_indiretos(valor_base, tipo_operacao, aliquota_icms_iss, aliquota_ipi=0):
    """
    Calcula os principais impostos indiretos sobre uma operação.
    """
    # Alíquotas padrão para PIS e Cofins (Regime Não-Cumulativo)
    aliquota_pis = 0.0165
    aliquota_cofins = 0.076
    
    # 1. Cálculo do IPI (Calculado "por fora" sobre a base)
    valor_ipi = valor_base * (aliquota_ipi / 100)
    
    # 2. PIS e Cofins
    valor_pis = valor_base * aliquota_pis
    valor_cofins = valor_base * aliquota_cofins
    
    # 3. ICMS ou ISS (Exclusivos por tipo de operação)
    valor_icms = 0
    valor_iss = 0
    
    if tipo_operacao.upper() == "PRODUTO":
        # ICMS incide sobre o valor da mercadoria
        valor_icms = valor_base * (aliquota_icms_iss / 100)
    elif tipo_operacao.upper() == "SERVIÇO":
        # ISS incide sobre o valor do serviço
        valor_iss = valor_base * (aliquota_icms_iss / 100)
    
    # 4. Totalizadores
    total_impostos = valor_ipi + valor_pis + valor_cofins + valor_icms + valor_iss
    valor_total_nota = valor_base + valor_ipi  # IPI soma no total da nota
    
    return {
        "Valor Base": valor_base,
        "ICMS": valor_icms,
        "ISS": valor_iss,
        "IPI": valor_ipi,
        "PIS": valor_pis,
        "Cofins": valor_cofins,
        "Total de Impostos Indiretos": total_impostos,
        "Carga Tributária Nominal (%)": (total_impostos / valor_base) * 100,
        "Valor Total da Nota": valor_total_nota
    }

# --- EXEMPLO DE USO ---
# Produto de R$ 10.000 com 18% de ICMS e 5% de IPI
resultado = calcular_impostos_indiretos(
    valor_base=10000.00, 
    tipo_operacao="PRODUTO", 
    aliquota_icms_iss=18.0, 
    aliquota_ipi=5.0
)

for chave, valor in resultado.items():
    if "Percentual" in chave or "%" in chave:
        print(f"{chave}: {valor:.2f}%")
    else:
        print(f"{chave}: R$ {valor:.2f}")

